# Credenciales del Copernicus Data Space Ecosystem (gratis).
#
# 1. Copia este fichero a ".env" (sin el .example). El .env NO se sube al repositorio.
# 2. Rellena los dos valores. Se obtienen en la consola:
#    https://dataspace.copernicus.eu -> dashboard -> User Settings -> OAuth clients -> Create new
#    (el Client Secret solo se muestra una vez; guárdalo en ese momento).
#
# Alternativa: definir estas variables de entorno en tu terminal.
# Las variables de entorno reales tienen prioridad sobre este fichero.

SH_CLIENT_ID=tu-client-id
SH_CLIENT_SECRET=tu-client-secret
